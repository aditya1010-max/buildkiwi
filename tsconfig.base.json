{
  "compilerOptions": {
    "target": "ES2022",

    "module": "CommonJS",
    "moduleResolution": "Node",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "paths": {
      "@buildkiwi/validation": [
        "packages/validation/src"
      ]
    }
  }
}