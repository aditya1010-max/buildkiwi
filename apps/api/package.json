{
  "name": "buildkiwi-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for BuildKiwi, a full-stack form builder platform.",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --files -r tsconfig-paths/register src/server.ts",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aditya1010-max/buildkiwi.git",
    "directory": "apps/api"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aditya1010-max/buildkiwi/issues"
  },
  "homepage": "https://github.com/aditya1010-max/buildkiwi#readme",
  "dependencies": {
    "@buildkiwi/pattern-engine": "*",
    "@buildkiwi/validation": "*",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "multer": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
